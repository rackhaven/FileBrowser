# Caddy reverse proxy with automatic HTTPS.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Caddy obtains and renews a Let's Encrypt certificate on its own. Point
# files.example.com's DNS at this machine first.

files.example.com {
	encode zstd gzip

	# The app sends its own security headers, but proxy-level basics are
	# cheap insurance in case something is ever served in front of it.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		-Server
	}

	# The server itself listens on plain HTTP on loopback only.
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Large uploads and long downloads must not be cut short. The server
	# itself streams files, so keep this generous.
	request_body {
		max_size 32GB
	}
}

# Serving a very large file over a slow link should be allowed to take a while.
transport http {
	read_timeout 0
	write_timeout 0
}
