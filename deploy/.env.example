# Copy to .env next to docker-compose.yml and edit.
# docker-compose.yml reads this file automatically.

# Required on first start. Generate one with:
#   openssl rand -base64 18
FB_ADMIN_PASSWORD=change-me-to-something-long

# Optional
FB_ADMIN_USER=admin
FB_VERSION=dev
FB_LOG_LEVEL=info

# Host directory holding your files.
FB_ROOT=../data/files

# Where the service listens on the host.
# Set to 127.0.0.0 when you terminate TLS at a reverse proxy or use Tailscale,
# so the port is not open to the internet.
FB_BIND=0.0.0.0
FB_PORT=8080

# true only behind a reverse proxy you control.
FB_TRUST_PROXY_HEADERS=false
