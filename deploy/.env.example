# Copy this file to deploy/.env (the compose file reads .env from its own
# directory) and edit the values:

#   cp deploy/.env.example deploy/.env
#   $EDITOR deploy/.env
#   docker compose -f deploy/docker-compose.yml up -d
#
# Every value here has the same default as in docker-compose.yml; only
# FB_ADMIN_PASSWORD is required. Aside from the files you serve, passwords
# and paths are the only decisions an operator actually needs to make.
#
# The password is used only when the data directory holds no users yet:
# after the first start, accounts live in the named volume and the password
# below is ignored.

# The initial administrator's password. Generate one, never ship the below.
FB_ADMIN_PASSWORD=

# Initial administrator's name. Defaults to admin.
#FB_ADMIN_USER=admin

# Which image tag to run. Pin one after upgrades matter: an exact version
# updates on your schedule, latest updates on the project's.
#FB_TAG=latest

# Port and bind address on the host. Defaults to all interfaces, port 8080;
# set FB_BIND=127.0.0.1 when a reverse proxy or VPN fronts the service.
#FB_PORT=8080
#FB_BIND=0.0.0.0

# Where your files live on the host. Bind-mounted into /srv/files read-write.
#FB_ROOT=../data/files

# Log level: debug, info, warn or error.
#FB_LOG_LEVEL=info

# Set to true only when a reverse proxy you control terminates TLS.
#FB_TRUST_PROXY_HEADERS=false

# Version stamped into a locally built image (docker compose build).
# A pulled image carries the version the release stamped.
#FB_VERSION=dev
